# Copy to .env and fill in. Restart the container after editing: docker compose up -d

# The bot token of your Discord application (Developer Portal > your application > Bot > Reset Token).
# Keep it secret: anyone who has it can post as the bot.
DISCORD_BOT_TOKEN=

# The numeric ID of the channel to post in (Discord > Settings > Advanced > Developer Mode, then right-click the
# channel > Copy Channel ID). The bot needs View Channel, Send Messages and Attach Files there.
DISCORD_CHANNEL_ID=

# The game server's report folder on this host: the "reports" folder inside the game's data folder
# (PETZ_DATA_DIR in the game's .env). Used by compose.yaml for the read-only mount.
REPORTS_HOST_DIR=/opt/docker/reframed/data/reports

# How often the folder is looked at, in seconds (5-3600).
POLL_SECONDS=15

# false: reports already stored when the bot first starts are taken as known and not posted.
# true: they are all posted at the first start, oldest first.
POST_EXISTING=false

# Upload the screenshot and the saved-data ZIP a player attached. The saved-data ZIP holds that player's pets and
# settings: everyone who can read the channel can download it. false keeps the file on the server and says so.
ATTACH_SCREENSHOT=true
ATTACH_SAVED_DATA=true

# The largest file uploaded, in bytes. Discord takes 10 MiB from a bot in a server without boosts; a larger file
# is left on the server and the message says so.
MAX_FILE_BYTES=10485760

# The image to run. Override for a pinned version tag.
BOT_IMAGE=ghcr.io/petzreframed/reframed-bug-tracker-bot:main
